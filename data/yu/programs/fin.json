  },
  {
   "code": "PLO2",
   "domain": "Knowledge and Understanding",
   "text": "Graduates will have a theoretical understanding of local and international financial markets and their competitive environments."
  },
  {
   "code": "PLO3",
   "domain": "Skills",
   "text": "Graduates demonstrate financial managerial skills to apply knowledge, theories, models, and procedures to solve financial tasks."
  },
  {
   "code": "PLO4",
   "domain": "Skills",
   "text": "Graduates will have investment, portfolio management, and financial risk management skills."
  },
  {
   "code": "PLO5",
   "domain": "Skills",
   "text": "Graduates possess strong computational and quantitative skills enabling development of financial models for sound decisions."
  },
  {
   "code": "PLO6",
   "domain": "Skills",
   "text": "Graduates are expected to produce clear, concise business reports and communicate their work in various formats."
  },
  {
   "code": "PLO7",
   "domain": "Values, Autonomy, and Responsibility",
   "text": "Graduates are committed life-long learners functioning independently and collaboratively with demonstrated leadership competence."
  },
  {
   "code": "PLO8",
   "domain": "Values, Autonomy, and Responsibility",
   "text": "Graduates will demonstrate ethically and socially responsible behavior in diverse professional contexts."
  }
