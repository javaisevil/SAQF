 "plos": [
  {
   "code": "PLO1",
   "domain": "Knowledge and Understanding",
   "text": "Graduates will have sound knowledge of the contemporary management tools used for the effective management of modern organizations."
  },
  {
   "code": "PLO2",
   "domain": "Knowledge and Understanding",
   "text": "Graduates will have a comprehensive understanding of the local and international cultures in which contemporary organizations operate and compete for resources."
  },
  {
   "code": "PLO3",
   "domain": "Skills",
   "text": "Graduates will have the ability to apply knowledge, theories, and models to solve managerial tasks."
  },
  {
   "code": "PLO4",
   "domain": "Skills",
   "text": "Graduates will be able to conduct research to find sound solutions for business and management-related issues."
  },
  {
   "code": "PLO5",
   "domain": "Skills",
   "text": "Graduates will demonstrate strong analytical and management skills that allow them to analyze, interpret business problems, and make sound management decisions."
  },
  {
   "code": "PLO6",
   "domain": "Skills",
   "text": "Graduates are expected to produce clear, concise business reports and communicate their work effectively in both oral and written forms."
  },
  {
   "code": "PLO7",
   "domain": "Values, Autonomy, and Responsibility",
   "text": "Graduates are committed life-long learners who work independently and/or in a team and demonstrate competent leadership."
  },
  {
   "code": "PLO8",
   "domain": "Values, Autonomy, and Responsibility",
   "text": "Graduates will demonstrate ethically and socially responsible behavior that enables them to make well-supported decisions in diverse environments."
  }
 ],
