# Copy to .env and change every password. Never commit .env.
APP_ENV=demo
APP_DEBUG=false
SAQF_PORT=8080
# demo = install schema + Al Yamamah demo scenario on first start; production = schema + YU data + one admin; off = do nothing
SAQF_AUTO_INSTALL=demo
SAQF_DEMO=true
SAQF_DB_NAME=saqf
SAQF_DB_USER=saqf
SAQF_DB_PASS=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
# true only when SAQF sits behind a reverse proxy / load balancer that sets X-Forwarded-For / X-Forwarded-Proto
SAQF_TRUST_PROXY=false
# real = ignore the demo clock anchor and use today's date in demo mode
# SAQF_DEMO_CLOCK=real
