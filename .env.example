# Copy to .env and change every password. Never commit .env.
# Full reference: README.md (configuration) and docs/INTEGRATIONS.md (university systems, SSO, e-mail).

# --- Application ---------------------------------------------------------------------------
APP_ENV=demo
APP_DEBUG=false
SAQF_PORT=8080
# demo = install schema + Al Yamamah demo scenario on first start; production = schema + YU data + one admin; off = do nothing
SAQF_AUTO_INSTALL=demo
SAQF_DEMO=true
# real = ignore the demo clock anchor and use today's date in demo mode
# SAQF_DEMO_CLOCK=real
# Public address of SAQF (links in e-mails, SSO redirect URI). Required for SSO and password reset.
# SAQF_BASE_URL=https://saqf.yu.edu.sa
# HTTPS: start with  docker compose --profile https up -d  and set the public name here (and SAQF_BASE_URL).
# In production also bind the plain port to the server itself:  SAQF_PORT=127.0.0.1:8080
# SAQF_DOMAIN=saqf.yu.edu.sa
# SAQF_HTTP_PORT=80
# SAQF_HTTPS_PORT=443
# Addresses allowed to report the client's address (X-Forwarded-For). The bundled proxy is 172.28.250.10;
# behind the university load balancer, list its address or range instead.
# SAQF_TRUSTED_PROXIES=172.28.250.10
SAQF_TRUST_PROXY=false
# Application key: derives student pseudonyms and encrypts stored secrets. REQUIRED in production
# (php bin/app_key.php generate; keep it in the password vault, backed up separately from the database).
# Demo/local only: when unset, a development key is generated and kept in the database.
# Never change it on an installation that has data (docs/OPERATIONS.md, "Application key").
# SAQF_APP_KEY=
# Any secret below can be given as a file instead (<NAME>_FILE=/run/secrets/...); the production overlay
# (docker-compose.prod.yml, docs/DEPLOY.md) does this for the application key and the database passwords.

# --- Database ------------------------------------------------------------------------------
SAQF_DB_NAME=saqf
SAQF_DB_USER=saqf
SAQF_DB_PASS=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
# Backups (docker compose "backup" service writes database + evidence files to ./backups, verified)
# SAQF_BACKUP_KEEP_DAYS=14
# Encrypt every backup (AES-256). Keep the passphrase in the university password vault — without it
# the backups cannot be restored.
# SAQF_BACKUP_PASSPHRASE=
# A second copy on another machine: a mounted network share, NAS or second disk on this server
# SAQF_BACKUP_OFFSITE_PATH=/mnt/saqf-backups
# Restore drill: every N days the newest backup is restored into a scratch server and checked (0 = never)
# SAQF_DRILL_EVERY_DAYS=30

# --- Security and IT operations ----------------------------------------------------------------
# Robot check on the sign-in and password-reset forms (self-hosted proof of work + hidden trap): on | off
# SAQF_BOT_CHECK=on
# Administrators may sign in only from these addresses / ranges (campus network, VPN)
# SAQF_ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.10.0/24
# IT alerts are also posted here (Microsoft Teams / Slack incoming webhook, JSON {"text": "..."})
# SAQF_ALERT_WEBHOOK=https://yu.webhook.office.com/...
# Virus scanning of evidence uploads: docker compose --profile antivirus up -d, then
# SAQF_CLAMAV_HOST=clamav:3310
# Published at /.well-known/security.txt (mailto: or https: address of the university's security team)
# SAQF_SECURITY_CONTACT=mailto:security@yu.edu.sa
# Extra recipients of the nightly audit-log checkpoint ("witness"), comma separated; administrators always get it
# SAQF_WITNESS_EMAIL=internal-audit@yu.edu.sa

# --- University systems (docs/INTEGRATIONS.md) ------------------------------------------------
# SIS: file (CSV exports in storage/inbox/sis) | rest (SAQF's SIS contract, docs/openapi) | mapped (any JSON API
#      described by a mapping file in config/mappings) | demo | none
# SAQF_SIS_SOURCE=file
# SAQF_SIS_URL=https://integration.yu.edu.sa/saqf
# SAQF_SIS_TOKEN=
# SAQF_SIS_MAPPING=config/mappings/sis.json
# Only when the mapping says "auth": {"type": "oauth2"} (client credentials):
# SAQF_SIS_CLIENT_ID=
# SAQF_SIS_CLIENT_SECRET=
# LMS: moodle | blackboard | mapped | file (gradebook exports in storage/inbox/lms) | demo | none
# SAQF_LMS_SOURCE=moodle
# Mapped LMS (check the file offline first: php bin/mapping_check.php config/mappings/lms.json --system=lms)
# SAQF_LMS_MAPPING=config/mappings/lms.json
# SAQF_LMS_URL=https://lms-api.yu.edu.sa
# SAQF_LMS_TOKEN=
# SAQF_LMS_CLIENT_ID=
# SAQF_LMS_CLIENT_SECRET=
# LMS course identifier pattern: {term}, {code} ("SWE 401"), {code_nospace} ("SWE401")
# SAQF_LMS_COURSE_KEY={term}-{code_nospace}
# How often Moodle / Blackboard are polled for new grades (minutes; export folders are read every run)
# SAQF_LMS_POLL_MINUTES=30
# SAQF_MOODLE_URL=https://lms.yu.edu.sa
# SAQF_MOODLE_TOKEN=
# SAQF_MOODLE_COURSE_FIELD=idnumber
# SAQF_BLACKBOARD_URL=https://yu.blackboard.com
# SAQF_BLACKBOARD_KEY=
# SAQF_BLACKBOARD_SECRET=

# --- University sign-in (OpenID Connect: Microsoft Entra ID, Google, Keycloak, ADFS …) -----------
# SAQF_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SAQF_OIDC_CLIENT_ID=
# SAQF_OIDC_CLIENT_SECRET=
# Optional: SAQF_OIDC_REDIRECT_URI (default <SAQF_BASE_URL>/sso.php), SAQF_OIDC_SCOPES ("openid profile email"),
# SAQF_OIDC_USERNAME_CLAIM (preferred_username), SAQF_OIDC_CLIENT_AUTH (post | basic), SAQF_OIDC_BUTTON_LABEL
# Refuse university sign-ins whose ID token does not report MFA (only if the identity provider sends "amr")
# SAQF_OIDC_REQUIRE_MFA=false
# Optional role mapping from the identity provider (app roles or groups)
# SAQF_OIDC_ROLE_CLAIM=roles
# SAQF_OIDC_ROLE_MAP=SAQF.Faculty=faculty;SAQF.HoD=hod;SAQF.Quality=qa;SAQF.Dean=dean;SAQF.Leadership=leadership;SAQF.Admin=admin
# Create accounts on first sign-in when a role can be derived (otherwise the admin adds people first)
# SAQF_OIDC_AUTO_PROVISION=false
# Role for auto-provisioned accounts when the token carries no mapped role (leave empty to require one)
# SAQF_OIDC_DEFAULT_ROLE=
# Who may still sign in with a password once SSO is on: all | admins (recommended break-glass) | off
# SAQF_PASSWORD_LOGIN=admins

# --- E-mail (notifications, invitations, password reset) ---------------------------------------
# smtp (default when SAQF_MAIL_HOST is set) | log (write to the log instead of sending) | off
# SAQF_MAIL_TRANSPORT=smtp
# SAQF_MAIL_HOST=smtp.office365.com
# SAQF_MAIL_PORT=587
# SAQF_MAIL_ENCRYPTION=tls
# SAQF_MAIL_USERNAME=saqf@yu.edu.sa
# SAQF_MAIL_PASSWORD=
# SAQF_MAIL_FROM=saqf@yu.edu.sa
# SAQF_MAIL_FROM_NAME=SAQF Academic Quality
